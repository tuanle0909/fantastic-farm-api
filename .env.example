# --- Fantastic Farm / Sui (testnet) ---
# Copy this file to `.env` and fill in values. Never commit `.env`.

PORT=8000
NODE_ENV=development
MONGODB_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list, e.g. http://localhost:5173,https://my-web.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Ed25519 seed for BE to sign mint proofs (32 bytes = 64 hex chars, no 0x).
# Must match `SERVER_ED25519_PUBLIC_KEY` in `sui_fantastic_farm/sources/sui_fantastic_farm.move`.
# Generate once, e.g. Ed25519Keypair.generate() then export secret hex + put public hex in Move.
FANTASTIC_FARM_MINT_SIGNING_PRIVATE_KEY_HEX=

SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# After `sui client publish`
FANTASTIC_FARM_PACKAGE_ID=
# Shared object `FarmRegistry` id from publish / explorer
FANTASTIC_FARM_REGISTRY_OBJECT_ID=
# Shared object type: <package>::farm_marketplace::Marketplace (same publish as PACKAGE_ID).
# NOT: CoinMetadata<FANTASTIC_COIN>, NOT FarmRegistry, NOT package id.
FANTASTIC_FARM_MARKETPLACE_OBJECT_ID=
# Shared FcMintRegistry (required for studio FC→reserve SUI job + client `sell_fc` / `buy_fc`):
# FANTASTIC_FARM_FC_MINT_REGISTRY_OBJECT_ID=0x...

# --- Studio treasury: periodic FC→SUI via on-chain reserve (`sell_fc_for_sui`; no DEX) ---
# Uses same PTB as Marketplace “Rút FC → SUI”. Private key MUST be wallet = Move `studio_fee_recipient`.
# REQUIRED: same shared object id as VITE_FANTASTIC_FARM_FC_MINT_REGISTRY_OBJECT_ID in react-client.
# STUDIO_FC_SWAP_ENABLED=true — also set FANTASTIC_FARM_FC_MINT_REGISTRY_OBJECT_ID + studio key below.
STUDIO_FC_SWAP_ENABLED=false
FANTASTIC_FARM_STUDIO_SWAP_PRIVATE_KEY_HEX=
STUDIO_SWAP_SIGNER_EXPECTED_ADDRESS=0x049e76351fec8e6fcf2d9f39e23858629a1d3de7bb67a72e998f91198184b2c1
STUDIO_FC_SWAP_INTERVAL_MS=3600000
STUDIO_FC_SWAP_MIN_AMOUNT_MIST=1000000000
# Optional legacy (unused for reserve path): STUDIO_FC_SWAP_SLIPPAGE_BPS=150
# STUDIO_FC_SWAP_ALLOW_NON_MAINNET=false

# --- Local / QA fast playtest (disable entire block on production) ---
# Turn OFF: unset `FANTASTIC_FARM_FAST_TEST` or set to `0` / `false`. Optionally remove the `FAST_TEST_*` lines below so defaults never apply.
#
# Spawn ≤ min per GDD-hour, faster hunger decay, shortened premium/starter bonuses, optional free hatch + free gold shop units.
# Existing animals get `nextSpawnAt` clamped on next GET /game/load — no DB reset needed.
#
# FANTASTIC_FARM_FAST_TEST=1
# FANTASTIC_FARM_TEST_SEC_PER_GDD_HOUR=15
# FANTASTIC_FARM_TEST_HUNGER_MULT=48
# FANTASTIC_FARM_TEST_PREMIUM_MIN=2
# FANTASTIC_FARM_TEST_FREE_HATCH=1
# FANTASTIC_FARM_TEST_FREE_SHOP=1
# FANTASTIC_FARM_TEST_STARTER_BONUS_HOURS=2
#
# Note: On-chain Egg shop + marketplace floor use `ECONOMY_ONCHAIN_SCALE_NUM/DEN` in `@fantastic-farm/shared` / Move (`1/10` test; set both **1** for prod bytecode).

# Optional: GET /api/onchain/mint-signer-pubkey — paste hex into `fantastic_smart_contract/sources/farm_config.move` (`server_public_key`) then republish.
